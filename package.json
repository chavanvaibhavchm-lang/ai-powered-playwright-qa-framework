{
  "name": "ai-powered-playwright-qa-framework",
  "version": "1.0.0",
  "description": "Free Playwright + TypeScript QA framework with Allure 3, offline SQLite API tests and optional local AI suggestions",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/run-suite.cjs --project=chromium --project=mobile-chromium --project=api --project=ai",
    "test:login": "playwright test tests/login.spec.ts --project=chromium",
    "test:login:headed": "playwright test tests/login.spec.ts --project=chromium --headed",
    "allure:generate": "node scripts/report.cjs",
    "allure:open": "allure open allure-report",
    "allure:clean": "node scripts/clean-allure.cjs",
    "test:smoke": "node scripts/run-suite.cjs --project=chromium --project=mobile-chromium --grep @smoke",
    "test:regression": "node scripts/run-suite.cjs --project=chromium --project=mobile-chromium",
    "test:negative": "node scripts/run-suite.cjs --project=chromium --grep @negative",
    "test:personas": "node scripts/run-suite.cjs tests/ui/personas --project=chromium --known-defects",
    "test:known-defects": "node scripts/run-suite.cjs --project=chromium --known-defects --grep @known-defect",
    "test:accessibility": "node scripts/run-suite.cjs --project=accessibility",
    "test:visual": "node scripts/run-suite.cjs --project=visual --update-snapshots=none",
    "test:visual:update": "node scripts/run-suite.cjs --project=visual --update-snapshots=all",
    "test:api": "node scripts/run-suite.cjs --project=api",
    "test:ai": "node scripts/run-suite.cjs --project=ai --grep-invert @local-ai",
    "test:ai:live": "node scripts/run-suite.cjs --project=ai --grep @local-ai",
    "test:examples": "node scripts/run-suite.cjs --project=examples",
    "test:cross-browser": "node scripts/run-suite.cjs --cross-browser --project=firefox --project=webkit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "companion:start": "tsx companion/start.ts",
    "ai:suggest": "tsx ai/generate.ts",
    "ai:suggest:live": "tsx ai/generate.ts --live",
    "record:run": "node scripts/record-run.cjs",
    "recon": "node scripts/recon.cjs",
    "test:ci": "node scripts/run-suite.cjs --project=chromium --project=mobile-chromium --project=api --project=ai --grep \"@smoke|API-0|AI-0\" --grep-invert \"@known-defect|@local-ai\"",
    "ai:approve": "tsx ai/review.ts",
    "test:portfolio": "node scripts/run-suite.cjs --known-defects --project=chromium --project=mobile-chromium --project=api --project=ai --project=accessibility --project=visual --update-snapshots=none",
    "allure:verify": "node scripts/verify-report.cjs",
    "prd:start": "tsx ai/prd-server.ts",
    "test:prd": "tsx --test ai/prd.test.ts ai/application.test.ts ai/pom-discovery.test.ts ai/automation-code.test.ts ai/automation-workflow.test.ts ai/scenario-evidence.test.ts ai/scenario-batches.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "ajv": "^8.20.0",
    "allure": "^3.20.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "eslint": "^10.12.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
